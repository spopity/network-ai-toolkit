[Unit]
Description=Network AI - router check (collect, summarize, roll up; no LLM)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/network-ai
ExecStart=/opt/network-ai/.venv/bin/python3 /opt/network-ai/collect_and_analyze.py --config /opt/network-ai/config.yml --mode check
User=root
# a check that hangs (router unreachable mid-command) must not block the next ones
TimeoutStartSec=4min
