# Example environment variables
# Rename to .env and fill values locally (do not commit)
GEMINI_API_KEY=your-gemini-api-key-here
USE_GCP_GEMINI=true
GEMINI_MODEL=models/gemini-pro-latest
# For Google Cloud: set to your service account JSON path or set USE_GCP_GEMINI=true and GOOGLE_APPLICATION_CREDENTIALS
NETWORK_AI_CONFIG=config.yml

# dedicated low-privilege role + isolated database on your Postgres server
PGHOST=your-postgres-host
PGPORT=5432
PGDATABASE=network_ai
PGUSER=network_ai_app
PGPASSWORD=changeme
