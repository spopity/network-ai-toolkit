#!/bin/sh
# Asuswrt-Merlin hook: /jffs/scripts/update-notification
# Called by the router's own scheduled firmware check (Administration -> Firmware
# Upgrade -> "Scheduled new firmware check") when a newer firmware is available.
# It ONLY reports the release to the network-ai dashboard, which pushes a Telegram
# notification -- it never downloads or flashes anything.
# Reports once per new version (retried on the next check if the dashboard was down).
# Test: /jffs/scripts/update-notification --test
# Source of truth: /opt/network-ai/router/update-notification (install: see README).

DASHBOARD_URL="http://192.168.1.10:8080/api/router-event"   # set to your dashboard host
STATE=/jffs/addons/update-notification.last

log() { logger -t update-notification "$*"; }

model="$(nvram get productid)"
current="$(nvram get firmver | tr -d .).$(nvram get buildno).$(nvram get extendno)"   # same format as $new
new="$(nvram get webs_state_info | sed 's/_/./g')"
test=false
[ "$1" = "--test" ] && test=true

if $test; then
    new="TEST (not a real release)"
else
    [ -n "$new" ] || exit 0
    [ "$new" = "$current" ] && exit 0   # webs_state_info keeps the last release found, even once installed
    [ "$(cat "$STATE" 2>/dev/null)" = "$new" ] && exit 0   # already reported this version
fi

body=$(printf '{"type":"firmware","model":"%s","current":"%s","new":"%s"}' "$model" "$current" "$new")
if curl -sf -m 15 --retry 2 -X POST -H 'Content-Type: application/json' -d "$body" "$DASHBOARD_URL" >/dev/null 2>&1; then
    $test || echo "$new" > "$STATE"
    log "reported new firmware $new (installed $current) to network-ai"
else
    log "new firmware $new available (installed $current) -- could not reach network-ai at $DASHBOARD_URL, will retry on the next check"
fi
