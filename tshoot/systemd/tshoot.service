[Unit]
Description=Tshoot - ASUS router troubleshooting agent (API for the network-ai dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tshoot
Environment=TSHOOT_CONFIG=/opt/tshoot/config.yml
ExecStart=/opt/tshoot/.venv/bin/python3 -m tshoot.app
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
