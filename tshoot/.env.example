GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-pro-latest
PGHOST=
PGPORT=5432
PGDATABASE=network_ai
PGUSER=
PGPASSWORD=
# Claude answers the chat when this is set: run
#   .venv/lib/python3.12/site-packages/claude_agent_sdk/_bundled/claude setup-token
# and paste the sk-ant-oat... token here. Empty = the chat uses Gemini.
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CHAT_MODEL=opus
# Shared secret with network-ai (its .env has the same TSHOOT_PROXY_KEY): Tshoot only answers
# requests from the dashboard proxy. Generate with: openssl rand -hex 32
TSHOOT_PROXY_KEY=
